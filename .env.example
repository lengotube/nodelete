# Never commit the real token. Create a fresh one in @BotFather.
TELEGRAM_BOT_TOKEN=
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET=
# 32-byte base64 key, used only to encrypt archived messages before storage.
ARCHIVE_ENCRYPTION_KEY=
# Vercel KV REST connection, optional for local command/UI testing.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Для VPS вместо Vercel KV: абсолютный путь к локальному зашифрованному хранилищу.
LOCAL_DATA_FILE=
# e.g. https://your-project.vercel.app
PUBLIC_APP_URL=
# Optional, used only for the community button.
COMMUNITY_URL=https://t.me/
