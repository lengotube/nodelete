# Ghost keeps its own database; the shared terminal must be configured explicitly.
GHOST_CHECKOUT_PUBLIC_URL=https://checkout.example.com
GHOST_CHECKOUT_DATABASE=/var/lib/ghost-checkout/payments.sqlite3
GHOST_CHECKOUT_INTERNAL_SECRET=
GHOST_EVENT_SECRET=
GHOST_EVENT_URL=https://api.example.com/api/card-payment-event
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
GHOST_SELLER_NAME=
GHOST_SELLER_INN=
GHOST_SELLER_REGISTRATION=
GHOST_SELLER_EMAIL=
GHOST_SUPPORT_URL=https://t.me/ghostmsg_support_bot
GHOST_OFFER_URL=https://example.com/ghost-offer
GHOST_PRIVACY_URL=https://example.com/ghost-privacy
GHOST_TERMS_VERSION=ghost-2026-11-03
# Use only values confirmed for this seller and its fiscal register.
GHOST_RECEIPT_TAXATION=
GHOST_RECEIPT_VAT=
GHOST_RECEIPT_LABEL=
GHOST_CHECKOUT_PORT=8093
GHOST_PROVIDER_TOKENIZATION_VERIFIED=
GHOST_PROVIDER_RECEIPTS_VERIFIED=
# Set only when the operator knowingly authorizes launch without a live test.
GHOST_PROVIDER_UNVERIFIED_DEPLOYMENT_ACKNOWLEDGED=
